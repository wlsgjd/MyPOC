;
; UnhideDebugger.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System ; TODO: specify appropriate Class
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider=%ManufacturerName%
CatalogFile=UnhideDebugger.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
UnhideDebugger_Device_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
UnhideDebugger.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%UnhideDebugger.DeviceDesc%=UnhideDebugger_Device, Root\UnhideDebugger ; TODO: edit hw-id

[UnhideDebugger_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
UnhideDebugger.sys

;-------------- Service installation
[UnhideDebugger_Device.NT.Services]
AddService = UnhideDebugger,%SPSVCINST_ASSOCSERVICE%, UnhideDebugger_Service_Inst

; -------------- UnhideDebugger driver install sections
[UnhideDebugger_Service_Inst]
DisplayName    = %UnhideDebugger.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\UnhideDebugger.sys

;
;--- UnhideDebugger_Device Coinstaller installation ------
;

[UnhideDebugger_Device.NT.CoInstallers]
AddReg=UnhideDebugger_Device_CoInstaller_AddReg
CopyFiles=UnhideDebugger_Device_CoInstaller_CopyFiles

[UnhideDebugger_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[UnhideDebugger_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[UnhideDebugger_Device.NT.Wdf]
KmdfService =  UnhideDebugger, UnhideDebugger_wdfsect
[UnhideDebugger_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "UnhideDebugger Installation Disk"
UnhideDebugger.DeviceDesc = "UnhideDebugger Device"
UnhideDebugger.SVCDESC = "UnhideDebugger Service"
